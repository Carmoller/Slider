<Window x:Class="Slider.SelectTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slider"
        xmlns:usercontrols="clr-namespace:Slider.UserControls"
        xmlns:commands="clr-namespace:Slider.Commands"
        mc:Ignorable="d"
        Title="SelectTileWindow" Height="450" Width="800" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Right" Command="commands:BoardCommands.MoveNext" />
        <KeyBinding Key="Left" Command="commands:BoardCommands.MovePrevious" />
        <KeyBinding Key="Up" Command="commands:BoardCommands.MoveUp" />
        <KeyBinding Key="Down" Command="commands:BoardCommands.MoveDown" />
        <KeyBinding Key="Space" Command="commands:BoardCommands.KeyboardSelect" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="commands:BoardCommands.MoveNext" Executed="MoveNext_Executed" />
        <CommandBinding Command="commands:BoardCommands.MovePrevious" Executed="MovePrevious_Executed" />
        <CommandBinding Command="commands:BoardCommands.MoveUp" Executed="MoveUp_Executed" />
        <CommandBinding Command="commands:BoardCommands.MoveDown" Executed="MoveDown_Executed" />
        <CommandBinding Command="commands:BoardCommands.KeyboardSelect" Executed="KeyboardSelect_Executed"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="23"/>
        </Grid.RowDefinitions>
        <usercontrols:BoardControl x:Name="MyBoard" ItemsSource="{Binding Board}" GridSize="{Binding GridSize}" CanSelect="True" CanGray="True" SelectionChanged="MyBoard_BoardSelectionChanged"/>
        <Button Grid.Row="1" HorizontalAlignment="Center" Content="Cancel" Width="75" Height="23" IsCancel="True"/>
    </Grid>
</Window>
