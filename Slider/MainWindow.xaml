<Window x:Name="window" x:Class="Slider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slider"
        xmlns:usercontrols="clr-namespace:Slider.UserControls"
        xmlns:vms="clr-namespace:Slider.ViewModels"
        mc:Ignorable="d"
        Title="Slider" Height="603" Width="944">
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="3">
                    <TextBlock Text="Grid Size:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="GridSizeSlider" Minimum="2" Maximum="12" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GridSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="{Binding GridSize}" />
                    <Run Text=" x " />
                    <Run Text="{Binding GridSize}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Animation Delay:" Margin="3,0,8,0" />
                    <Slider Minimum="0" Maximum="1000" Width="140" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding AnimationDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock>
                        <Run Text="{Binding AnimationDelay}"/>
                        <Run Text="ms"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
            <Border  Grid.Row="1" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="Black" Height="{Binding ActualHeight, ElementName=grid, Mode=OneWay}" Width="{Binding ActualHeight, ElementName=grid, Mode=OneWay}">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/box.png" Stretch="Fill"/>
                </Border.Background>
                <Canvas Margin="25,20,25,20" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" SizeChanged="Canvas_SizeChanged">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Beige"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <usercontrols:TileControl Width="{Binding TileSize}" Height="{Binding TileSize, Mode=OneWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>
        </Viewbox>
        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Content="New" Command="{Binding NewGameCommand}" Width="45" Height="23" Margin="3"/>
                <Button Content="Undo" Command="{Binding UndoCommand}" Width="45" Height="23" Margin="3"/>
                <Button Content="Solve" Command="{Binding SolveCommand}" Width="45" Height="23" Margin="3"/>
                <Button Content=">>" Command="{Binding AutoPlayCommand}" Width="45" Height="23" Margin="3"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Heuristic:" Margin="3,0,0,0"/>
                    <TextBlock Text="{Binding Heuristic, Mode=OneWay}" Margin="3,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Margin="3">
                    <Run Text="Moves"/>
                    <Run Text="{Binding NumberOfMoves, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Margin="3">
                    <Run Text="Time"/>
                    <Run Text="{Binding TimeElapsed, Mode=OneWay}"/>
                </TextBlock>
                <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding SolveMoves}" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="3">
                    <ListBox.Resources>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSolveDataAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSolveDataAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="From ("/>
                                <Run Text="{Binding FromRow}"/>
                                <Run Text=","/>
                                <Run Text="{Binding FromColumn}"/>
                                <Run Text=") To ("/>
                                <Run Text="{Binding ToRow}"/>
                                <Run Text=","/>
                                <Run Text="{Binding ToColumn}"/>
                                <Run Text="), "/>
                                <Run Text="{Binding NodeIndex}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding CurrentH}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Grid Grid.Row="2">
                <Grid.Resources>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSolveDataAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSolveDataAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Result"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SolveResult}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Solve time"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SolveTime, StringFormat=\{0:mm\\:ss\\.fff\}}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Moves"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SolveMoveCount}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="States"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalStatesConsidered}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Minum H"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MinimumH}"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="MinimumH Index"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MinimumHNodeIndex}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
