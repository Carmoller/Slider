<Window x:Class="Slider.BuildPuzzleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slider"
        xmlns:viewmodels="clr-namespace:Slider.ViewModels"
        xmlns:usercontrols="clr-namespace:Slider.UserControls"
        xmlns:commands="clr-namespace:Slider.Commands"
        mc:Ignorable="d"
        Title="BuildPuzzleWindow" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="Right" Command="commands:BoardCommands.MoveNext" />
        <KeyBinding Key="Left" Command="commands:BoardCommands.MovePrevious" />
        <KeyBinding Key="Up" Command="commands:BoardCommands.MoveUp" />
        <KeyBinding Key="Down" Command="commands:BoardCommands.MoveDown" />
        <KeyBinding Key="Return" Command="commands:BoardCommands.KeyboardSelect" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="commands:BoardCommands.MoveNext" Executed="MoveNext_Executed" />
        <CommandBinding Command="commands:BoardCommands.MovePrevious" Executed="MovePrevious_Executed" />
        <CommandBinding Command="commands:BoardCommands.MoveUp" Executed="MoveUp_Executed" />
        <CommandBinding Command="commands:BoardCommands.MoveDown" Executed="MoveDown_Executed" />
        <CommandBinding Command="commands:BoardCommands.KeyboardSelect" Executed="KeyboardSelect_Executed"/>
    </Window.CommandBindings>
    <Window.DataContext>
        <viewmodels:BuildPuzzleViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <usercontrols:BoardControl x:Name="MyBoard" GridSize="{Binding GridSize, TargetNullValue=6, FallbackValue=6}" ItemsSource="{Binding Board}" CanSelect="True" SelectionChanged="MyBoard_SelectionChanged" />
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Grid Size:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Grid.Row="0" Grid.Column="1"  Orientation="Horizontal" DockPanel.Dock="Top" Margin="3">
                <Slider x:Name="GridSizeSlider" Minimum="2" Maximum="10" Width="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GridSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="{Binding GridSize}" />
                    <Run Text=" x " />
                    <Run Text="{Binding GridSize}" />
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Solvable"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SolvableStatus}"/>
        </Grid>
              
        <StackPanel Grid.Column="1" Orientation="Vertical">
        </StackPanel>
    </Grid>
</Window>
